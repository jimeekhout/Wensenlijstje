generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection used by the app (Neon pooler on Vercel).
  url       = env("DATABASE_URL")
  // Direct connection used by Prisma migrations. Required with Neon's pooler.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String?
  /// Google's stable account id (`sub`). Set when the user signs in with Google.
  googleSub    String?    @unique
  createdAt    DateTime   @default(now())
  lists        WishList[]
  sessions     Session[]
  draws        Draw[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model WishList {
  id             String     @id @default(cuid())
  title          String
  occasion       String
  occasionCustom String?
  eventDate      DateTime?
  /// bcrypt hash. Empty means the share link is open.
  accessHash     String?
  shareToken     String     @unique
  ownerId        String
  owner          User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items          WishItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([ownerId])
}

model WishItem {
  id          String   @id @default(cuid())
  listId      String
  list        WishList @relation(fields: [listId], references: [id], onDelete: Cascade)
  name        String
  description String?
  url         String?
  priceCents  Int?
  imageUrl    String?
  priority    Int?
  sortOrder   Int      @default(0)
  claim       Claim?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([listId])
}

model Draw {
  id           String           @id @default(cuid())
  title        String
  eventDate    DateTime?
  budgetCents  Int?
  ownerId      String
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  drawnAt      DateTime?
  participants DrawParticipant[]
  exclusions   DrawExclusion[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([ownerId])
}

model DrawParticipant {
  id                 String    @id @default(cuid())
  drawId             String
  draw               Draw      @relation(fields: [drawId], references: [id], onDelete: Cascade)
  name               String
  email              String?
  token              String    @unique
  viewedAt           DateTime?
  /// Who this person draws. Organiser screens must never select this column.
  drawsParticipantId String?
  wishShareToken     String?
  createdAt          DateTime  @default(now())

  @@index([drawId])
}

model DrawExclusion {
  id     String @id @default(cuid())
  drawId String
  draw   Draw   @relation(fields: [drawId], references: [id], onDelete: Cascade)
  aId    String
  bId    String

  @@unique([drawId, aId, bId])
  @@index([drawId])
}

/// A reservation made by a visitor. Never query this from the owner's pages.
model Claim {
  id          String   @id @default(cuid())
  itemId      String   @unique
  item        WishItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claimerName String
  secretHash  String
  createdAt   DateTime @default(now())
}
