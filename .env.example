# SQLite file used for local development. The path is relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Optional origin used when building share links, without a trailing slash.
# Example on Vercel: https://wensenlijstje.vercel.app
# APP_URL="http://localhost:3000"

# Optional affiliate identifiers. Leave empty locally.
# Amazon.nl product and search links get ?tag= this value when rendered.
# AMAZON_NL_ASSOCIATE_TAG=""
# Bol.com links are wrapped in a partner.bol.com click URL when this numeric site id is set.
# BOL_SITE_ID=""
