# Local Postgres from `docker compose up -d`.
# On Vercel, DATABASE_URL is the Neon pooled URL and DIRECT_URL is the direct URL.
DATABASE_URL="postgresql://wensenlijstje:wensenlijstje@127.0.0.1:5432/wensenlijstje"
DIRECT_URL="postgresql://wensenlijstje:wensenlijstje@127.0.0.1:5432/wensenlijstje"

# Session tokens are hashed with this secret. Replace it before deploying.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="local-dev-only-not-for-production-secret"

# Public origin used in share links, without a trailing slash.
# Locally this can stay on http. Production must be https, for example https://hetwensenlijstje.nl
APP_URL="http://localhost:3000"

# Google sign-in. Leave both unset to hide "Doorgaan met Google".
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Optional affiliate identifiers. Leave empty until you have partner accounts.
# AMAZON_NL_ASSOCIATE_TAG=""
# BOL_SITE_ID=""
